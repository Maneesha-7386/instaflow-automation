# Firebase Cloud Functions Backend Environment Configuration (Template)
# Copy this to functions/.env and populate with your credentials.

# Meta / Instagram Server-Side OAuth & Webhook Credentials
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_REDIRECT_URI=http://localhost:5173/auth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=YOUR_META_WEBHOOK_VERIFY_TOKEN
META_GRAPH_API_VERSION=v19.0

# Token Vault Encryption (32-byte hex key for AES-256 encryption of Meta OAuth tokens)
TOKEN_ENCRYPTION_KEY=YOUR_32_BYTE_HEX_ENCRYPTION_KEY

# Backend AI Service Integrations
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
AI_IMAGE_API_KEY=YOUR_AI_IMAGE_API_KEY
AI_TTS_API_KEY=YOUR_AI_TTS_API_KEY

# CORS & Frontend Origin
ALLOWED_ORIGIN=http://localhost:5173

