rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function ownsExisting() {
      return isSignedIn() && resource.data.userId == request.auth.uid;
    }

    function createsOwned() {
      return isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    function keepsOwnerOnUpdate() {
      return ownsExisting() && request.resource.data.userId == resource.data.userId;
    }

    // User profile document
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Connected Instagram accounts (public metadata only; tokens remain vaulted server-side)
    match /instagramAccounts/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwned();
      allow update: if keepsOwnerOnUpdate();
    }

    // Reels & Posts content metadata
    match /mediaContent/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwned();
      allow update: if keepsOwnerOnUpdate();
    }

    // AI Studio generations metadata
    match /aiGenerations/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwned();
      allow update: if keepsOwnerOnUpdate();
    }

    // Automation workflows
    match /automations/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwned();
      allow update: if keepsOwnerOnUpdate();
    }

    // Execution & Publishing history logs
    match /history/{docId} {
      allow read, delete: if ownsExisting();
      allow create: if createsOwned();
      allow update: if keepsOwnerOnUpdate();
    }

    // Backend-only encrypted Meta OAuth tokens vault (never accessible from client SDK)
    match /vault_secrets/{docId=**} {
      allow read, write: if false;
    }
  }
}
