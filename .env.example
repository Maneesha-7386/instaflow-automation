# Firebase Authentication & Database Configuration
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-app-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Meta Developer App Configuration (Instagram Graph API & Messenger Platform)
# Note: Client Secret and Long-Lived Tokens are securely vaulted in backend Cloud Functions
VITE_META_APP_ID=YOUR_META_APP_ID
VITE_META_REDIRECT_URI=http://localhost:5173/auth/meta/callback

# Backend Cloud Functions API URL (use http://localhost:5001/your-app-id/us-central1 for local backend)
VITE_API_BASE_URL=https://us-central1-your-app-id.cloudfunctions.net

# Optional: Set to 'true' to route Auth, Firestore & Storage SDKs to local Firebase Emulator Suite
#VITE_USE_FIREBASE_EMULATORS=false
